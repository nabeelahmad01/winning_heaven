APP_NAME="Winning Heaven"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://winningheaven.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Hostinger MySQL (from hPanel → Databases) ───
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u478841759_winning_heaven
DB_USERNAME=u478841759_winning_heaven
DB_PASSWORD=PASTE_YOUR_DB_PASSWORD_HERE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.winningheaven.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Hostinger Email (hPanel → Emails → create mailbox) ───
# Create e.g. noreply@winningheaven.com then use that password here.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@winningheaven.com
MAIL_PASSWORD=PASTE_YOUR_MAILBOX_PASSWORD_HERE
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="noreply@winningheaven.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── HQ bootstrap (first login creates this admin if missing) ───
ADMIN_EMAIL=admin@winningheaven.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Google Sign-In (optional) ───
# https://console.cloud.google.com/ → Credentials → OAuth client ID (Web)
# Authorized JavaScript origins: https://winningheaven.com
GOOGLE_CLIENT_ID=

# ─── Web Push VAPID (optional — Promotions / Push tab) ───
# Generate once on your Mac:
#   npx web-push generate-vapid-keys
# Paste Public + Private below. Subject = your email.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@winningheaven.com
