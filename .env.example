APP_NAME="Winning Heaven"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (MySQL / MariaDB — required for production) ───
# Create DB:  mysql -h 127.0.0.1 -u root -e "CREATE DATABASE winning_heaven CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
# Then:       php artisan migrate
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=winning_heaven
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@winningheaven.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── HQ bootstrap login (created on first login if missing) ───
ADMIN_EMAIL=admin@winningheaven.com
ADMIN_PASSWORD=admin123

# ─── Google Sign-In (GIS — player login/register buttons) ───
# 1) https://console.cloud.google.com/ → create/select project
# 2) APIs & Services → Credentials → Create Credentials → OAuth client ID
# 3) Application type: Web application
# 4) Authorized JavaScript origins: http://localhost:8000  (+ your production https://domain)
# 5) Authorized redirect URIs: same origins (GIS popup does not need a secret for ID tokens)
# 6) Copy the Client ID here (looks like ....apps.googleusercontent.com)
# Leave empty to keep Google buttons as “configure me” stubs.
GOOGLE_CLIENT_ID=

# ─── Web Push (HQ Push tab → player browsers) ───
# Generate once on your computer:
#   npx web-push generate-vapid-keys
# Copy Public Key + Private Key below.
# Subject must be mailto: or https: you own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@winningheaven.com

# ─── Hostinger production: copy from .env.hostinger.example ───
# DB: hPanel → Databases (you already have u478841759_winning_heaven)
# MAIL: hPanel → Emails → create noreply@yourdomain → smtp.hostinger.com:465 MAIL_SCHEME=smtps
# APP_KEY: run  php artisan key:generate  on the server
# Google: https://console.cloud.google.com/ → OAuth Web Client ID
